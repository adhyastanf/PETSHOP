# API
# Legacy direct backend base (still read by transitional code paths).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Backend base used by the Next.js API route handlers / proxy (server-side).
# Must include the backend's /api/v1 prefix (there is no servlet context-path;
# the prefix is declared on each Spring @RequestMapping).
BACKEND_URL=http://localhost:8080/api/v1

# Base URL of this Next.js app, used by the axios instance during SSR.
INTERNAL_APP_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_NAME=Oyen
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,id
NEXT_PUBLIC_ENVIRONMENT=development
